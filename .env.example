# Public address the source is served from (used inside source.json).
BASE_URL=http://localhost:8080

# Path segment the dashboard lives behind. Leave empty to auto-generate
# a random one on first boot (persisted in the database).
# Example: ADMIN_PATH=p-8hhkntcjt4scm68a  ->  https://host/p-8hhkntcjt4scm68a/
ADMIN_PATH=

# Admin password for the web UI. Leave empty to disable the login wall.
ADMIN_TOKEN=

# Optional GitHub token: raises the API limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# Seconds a repository's release data stays cached.
CACHE_SECONDS=600

PORT=8080
DATA_DIR=./data
WEB_DIR=./web/dist

